# Dependencies
node_modules/

# Build / dev-server output
dist/
.vite/

# Vendored React runtime (copied from node_modules by postinstall)
public/vendor/

# Packaged desktop-app installers (electron-builder output)
release/

# Generated prototype exports (standalone HTML, PNGs, zips)
projects/*/exports/

# The projects root's active-project pointer (local state)
projects/.active

# Logs
*.log
npm-debug.log*

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Planning / personal notes — kept local, not in the public repo
PLAN.md
COLLABORATION.md

# Wiki lives in its own repo (github.com/djbohl/CodeToUI-Playground.wiki.git)
wiki/
